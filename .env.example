# Copy to .env. Never commit .env.

SYNAPSE_ENV=local
SYNAPSE_LOG_LEVEL=INFO
SYNAPSE_LOG_JSON=true
SYNAPSE_API_HOST=127.0.0.1
SYNAPSE_API_PORT=8000

SYNAPSE_DATABASE_URL=postgresql+asyncpg://synapse:synapse@127.0.0.1:5432/synapse
SYNAPSE_REDIS_URL=redis://127.0.0.1:6379/0

# HS256 signing key — min 32 chars. Rotate for anything beyond local demo.
SYNAPSE_JWT_SECRET=dev-only-change-me-synapse-jwt-32chars!!
SYNAPSE_JWT_TTL_MINUTES=60
SYNAPSE_DEMO_PASSWORD=synapse-demo

SYNAPSE_GROQ_API_KEY=
SYNAPSE_OPENAI_API_KEY=

# Hacker News and Stack Overflow need no key. Tavily does.
# SYNAPSE_TAVILY_API_KEY=
# SYNAPSE_STACKEXCHANGE_KEY=     # optional; higher Stack Overflow quota

# AWS uses the same names. Put them in Secrets Manager (see deploy/aws/secrets.env.example).
# Do not commit the filled file. GitHub Actions CI does not read these keys.
