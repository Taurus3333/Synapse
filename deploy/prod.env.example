# Production runtime contract for Synapse API (ECS task env / Secrets Manager).
# Do not commit real values. Terraform writes these into Secrets Manager on apply.
#
# Required:
#   SYNAPSE_ENV=prod
#   SYNAPSE_API_HOST=0.0.0.0
#   SYNAPSE_API_PORT=8000
#   SYNAPSE_LOG_JSON=true
#   SYNAPSE_JWT_SECRET=<≥32 chars, not the local dev-only value>
#   SYNAPSE_DATABASE_URL=postgresql+asyncpg://…?ssl=require
#   SYNAPSE_REDIS_URL=redis://…:6379/0
#   SYNAPSE_GROQ_API_KEY=…   OR   SYNAPSE_OPENAI_API_KEY=…
#
# Optional:
#   SYNAPSE_DEMO_PASSWORD=…          # seed/bootstrap only
#   SYNAPSE_GITHUB_TOKEN=…
#   SYNAPSE_SLACK_BOT_TOKEN=…
#   SYNAPSE_GMAIL_ACCESS_TOKEN=…
#
# After first RDS boot (one-off task / psql):
#   CREATE EXTENSION IF NOT EXISTS vector;
#   synapse-seed --profile ci --seed 42
#   synapse-ingest
#
# HTTPS: set terraform var acm_certificate_arn to an ACM cert in the same region.
